# Copy to .env and fill in. Never commit .env.

# Provider keys (free tiers). Providers with no key are skipped in fallback chains.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Comma-separated keys that clients use to call RouteWise (Authorization: Bearer <key>).
ROUTEWISE_API_KEYS=rw-dev-key

# Infrastructure. Docker Compose overrides these with the service hostnames.
# Redis is OPTIONAL. Leave REDIS_URL unset to run without it: the exact cache is off,
# rate limiting / circuit breakers keep state in memory, and the semantic cache (FAISS +
# SQLite, no Redis) works as usual. Uncomment to enable the exact cache:
# REDIS_URL=redis://localhost:6379/0
# Postgres:  postgresql://routewise:routewise@localhost:5432/routewise
# SQLite (default if unset): sqlite:///data/routewise.db
DATABASE_URL=sqlite:///data/routewise.db
